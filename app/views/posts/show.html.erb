<% content_for :title, "#{@post.title} | My Blog" %>

<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <a href="/" class="logo">My Blog</a>
      <nav class="nav">
        <a href="/">ホーム</a>
        <a href="/posts" class="nav-active">記事</a>
        <a href="/authors">著者</a>
        <a href="/contact">お問い合わせ</a>
      </nav>
    </div>
  </div>
</header>

<main class="container" style="padding-top: 56px; padding-bottom: 80px; max-width: 760px;">
  <a href="/posts" class="back-link">← 記事一覧に戻る</a>
  <article class="post-detail">
    <h1 class="post-detail-title"><%= @post.title %></h1>
    <div class="post-meta" style="margin-bottom: 32px;">
      <span class="post-author-badge"><%= @post.user.name[0].upcase %></span>
      <span class="post-author-name"><%= @post.user.name %></span>
      <span class="post-date"><%= @post.created_at.strftime("%Y年%m月%d日") %></span>
    </div>
    <div class="post-body"><%= simple_format(@post.body) %></div>
  </article>
</main>

<footer class="site-footer">
  <div class="container">
    <p>© 2026 My Blog. All rights reserved.</p>
  </div>
</footer>
